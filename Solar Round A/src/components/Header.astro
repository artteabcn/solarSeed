---
import { translations } from '../i18n/translations.js';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang] || translations.en;

const homePaths = { en: '/', fr: '/fr/', th: '/th/' };
const homeHref = homePaths[lang] || '/';

const languages = [
  { code: 'en', href: '/' },
  { code: 'fr', href: '/fr/' },
  { code: 'th', href: '/th/' },
];

const navLinks = [
  { label: t.nav.metrics, href: `${homeHref}#metrics` },
  { label: t.nav.roadmap, href: `${homeHref}#timeline` },
];
---
<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-black/5">
  <div class="container mx-auto px-6 max-w-7xl flex items-center justify-between h-20">
    <a href={homeHref} class="font-extrabold text-xl tracking-tight text-charcoal">
      Solar <span class="text-primary">Khanom</span>
    </a>
    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-charcoal/70 hover:text-primary transition-colors">
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-1">
      {languages.map((l) => (
        <a
          href={l.href}
          class={`px-2 py-1 text-sm font-bold uppercase transition-colors ${lang === l.code ? 'text-primary' : 'text-charcoal/40 hover:text-primary'}`}
          aria-current={lang === l.code ? 'page' : undefined}
        >
          {l.code}
        </a>
      ))}
    </div>
  </div>
</header>
